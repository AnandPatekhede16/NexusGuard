# NexusGuard Backend Environment Variables Configuration

# Application Metadata
PROJECT_NAME="NexusGuard API"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Security
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Standard format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexusguard"

# CORS Configuration (Comma-separated list of permitted origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Future AI Integrations (Optional)
# GEMINI_API_KEY=""
